---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import Toc from '../components/Toc.astro';
import VerifyNote from '../components/VerifyNote.astro';
import FaqList from '../components/FaqList.astro';
import RelatedEntries from '../components/RelatedEntries.astro';
import PrevNext from '../components/PrevNext.astro';
import { articleJsonLd, breadcrumbJsonLd, faqJsonLd } from '../lib/seo';
import { sectionOf, resolveRelated, readingMinutes, type AnyEntry } from '../lib/entries';
import { entryUrl } from '../data/site';

interface Props {
  entry: AnyEntry;
  headings: MarkdownHeading[];
  prev?: AnyEntry;
  next?: AnyEntry;
}

const { entry, headings, prev, next } = Astro.props;
const d = entry.data;
const section = sectionOf(entry.collection);
const path = entryUrl(entry.collection, entry.id);
const crumbs = [
  { name: section.name, url: section.url },
  { name: d.title, url: path },
];
const related = await resolveRelated(d.relatedSlugs);
const minutes = readingMinutes(entry.body);
const fmt = (date: Date) =>
  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;

const jsonLd: object[] = [
  breadcrumbJsonLd([{ name: '首页', url: '/' }, ...crumbs]),
  articleJsonLd({
    title: d.title,
    description: d.description,
    url: path,
    pubDate: d.pubDate,
    updatedDate: d.updatedDate,
    author: d.author,
  }),
];
if (d.faq.length > 0) jsonLd.push(faqJsonLd(d.faq));

const isRisk = entry.collection === 'risk';
const riskLevel = isRisk && 'riskLevel' in d ? (d as { riskLevel: string }).riskLevel : undefined;
---

<BaseLayout title={`${d.title} — 海外Wiki`} description={d.description} path={path} ogType="article" jsonLd={jsonLd}>
  <Breadcrumb crumbs={crumbs} />

  <article class="mx-auto mt-8 max-w-[740px]">
    <header>
      <p class="text-xs text-ink-2 flex items-center gap-3">
        <span class="index-num">{section.num}</span>
        <span class="corner-label">{d.contentType}</span>
      </p>
      <h1 class="mt-3 text-[1.8rem] sm:text-[2.1rem] font-bold leading-[1.3] text-ink">{d.title}</h1>
      <p class="mt-3 text-[0.98rem] text-ink-2 leading-relaxed">{d.description}</p>
      <p class="mt-4 pb-5 border-b border-rule text-xs text-ink-2 flex flex-wrap gap-x-4 gap-y-1">
        <span>{d.author}</span>
        <span>发布 {fmt(d.pubDate)}</span>
        {d.updatedDate && <span>修订 {fmt(d.updatedDate)}</span>}
        <span>约 {minutes} 分钟</span>
      </p>
    </header>

    {isRisk && riskLevel && (
      <aside class="mt-6 border-l-[3px] border-cinnabar bg-cinnabar-2 px-5 py-3 text-sm">
        <p><strong class="text-cinnabar font-semibold">风险内容 · {riskLevel}</strong>
          <span class="text-ink-2 ml-2">本文区分事实、观察与推测,请结合发布与核验时间判断时效。</span></p>
      </aside>
    )}

    {d.quickAnswer && <div class="mt-6"><QuickAnswer text={d.quickAnswer} /></div>}

    <div class="mt-6"><Toc headings={headings} /></div>

    <div class="entry-body mt-8">
      <slot />
    </div>

    <VerifyNote reviewStatus={d.reviewStatus} lastVerified={d.lastVerified} />

    {d.faq.length > 0 && <FaqList faq={d.faq} />}

    <RelatedEntries entries={related} />

    <PrevNext
      prev={prev && { title: prev.data.title, url: entryUrl(prev.collection, prev.id) }}
      next={next && { title: next.data.title, url: entryUrl(next.collection, next.id) }}
    />
  </article>
</BaseLayout>
