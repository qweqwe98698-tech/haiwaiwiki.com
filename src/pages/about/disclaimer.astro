---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { breadcrumbJsonLd, pageJsonLd } from '../../lib/seo';
import { STATIC_PAGES, SITE } from '../../data/site';

const meta = STATIC_PAGES['/about/disclaimer/'];
const jsonLd = [
  breadcrumbJsonLd([
    { name: '首页', url: '/' },
    { name: '关于本站', url: '/about/' },
    { name: '免责声明', url: '/about/disclaimer/' },
  ]),
  pageJsonLd('WebPage', { name: meta.title, description: meta.description, url: '/about/disclaimer/' }),
];
---

<BaseLayout title={meta.title} description={meta.description} path="/about/disclaimer/" jsonLd={jsonLd}>
  <Breadcrumb crumbs={[{ name: '关于本站', url: '/about/' }, { name: '免责声明', url: '/about/disclaimer/' }]} />
  <article class="entry-body mx-auto mt-10">
    <h1 class="text-2xl font-bold">免责声明与商业推广披露</h1>

    <h2>一、内容性质与技术研究定位</h2>
    <p>
      HaiwaiWiki（海外Wiki）所刊载的所有文章、技术词条、架构图解、排查流程与参数对照表，均为面向计算机网络技术研究、跨国学术资料查阅、海外开源项目协同及合法跨境通信场景的技术知识整理与信息参考。
    </p>
    <p>
      本站所提供的信息不构成任何形式的法律建议、购买推介、商业担保或财务投资建议。使用任何网络代理服务、加密通信工具或远程服务器时，用户应自觉遵守所在国家和地区的现行法律法规与电信监管政策。因用户个人使用、配置不当或违规操作而产生的任何直接或间接法律责任与经济损失，均由使用者自行承担，本站概不负责。
    </p>

    <h2>二、商业推广链接（Affiliate Disclosure）披露细则</h2>
    <p>
      为维持站点的服务器托管成本、测试环境开销及持续的词条维护更新，本站与部分经过公开资料核准的第三方服务商建立了商业推广合作（Affiliate Program）。根据全球透明度准则（包括但不限于 FTC 披露准则及搜索引擎商业链接指南），我们在所有读者可能点击跳转的环节进行如下显式说明：
    </p>
    <ul>
      <li><strong>零额外加价承诺</strong>：经由本站提供的推广链接或专属优惠码购买服务，您所需支付的实际价格与直接访问该服务商官网一致，甚至可能因合作优惠码而获得折扣。返利佣金由服务商从既有利润中向本站支付，绝不会转嫁到您的账单上；</li>
      <li><strong>严格合规标记</strong>：全站所有指向外部商业服务商的跳转链接均统一设置 <code>rel="nofollow sponsored noopener"</code> 属性，坚决杜绝任何传递 PageRank 的违规暗链或伪装内链；</li>
      <li><strong>版位醒目声明</strong>：所有包含商业合作展示的列表、卡片与专栏，均在表头或卡片角落明确标注“商业展示”或“含推广链接”；</li>
      <li><strong>结论独立性保障</strong>：商业合作关系的建立绝不影响编辑部的客观陈述。评测中的“官方宣称参数”与“已知限制/无法核验项”严格分离，合作品牌绝不享受任何形式的虚假优待或免责豁免，这一点由本站公开的<a href="/about/editorial/">编辑规范</a>进行刚性约束。</li>
    </ul>

    <h2>三、服务商动态数据与价格免责</h2>
    <p>
      网络工具及代理服务商的套餐资费、流量配额、节点地域分布、客户端支持策略及退款协议属于高度动态变化的市场信息。本站各品牌档案中注明的“最后核验日期（lastVerified）”仅代表编辑部在该时间点对公开信息的取证状态，不构成对服务商当前或未来服务质量的永久保证。
    </p>
    <p>
      由于服务商可能在不提前通知的情况下调整价格、变更线路类型或修改服务条款，强烈建议读者在最终付款结算前，务必仔细核对目标服务商官网的《服务条款》（ToS）与最新结算明细。若发生服务争议、退款纠纷或服务商单方面终止运营，用户需依据双方的服务协议与服务商进行协商处理。
    </p>

    <h2>四、知识产权与内容引用规范</h2>
    <p>
      本站中出现的所有第三方产品名称、品牌标识、协议缩写及服务商标，其所有权均归属于其各自的商标持有人。本站对上述名称与标识的使用仅为事实陈述、技术对比及指引性引用，并不意味着本站与相关商标持有方存在隶属、控股、代理或官方授权关系。
    </p>
    <p>
      HaiwaiWiki 站内所有原创技术分析、排查决策树、图表设计与结构化汇总文本，均受国际版权法规保护。严禁任何组织或个人采用自动化爬虫对本站进行未经授权的镜像复制、批量洗稿或商用打包。若需非商业性质引用，必须明确注明出处为 <code>haiwaiwiki.com</code> 并保留指向原始词条的超链接。
    </p>

    <h2>五、勘误与监督反馈</h2>
    <p>
      若您发现某项条目中存在过时参数、失效链接或需要补充的事实证据，请随时致信编辑部监督邮箱：<a href={`mailto:${SITE.email}`}>{SITE.email}</a>。我们将以严肃严谨的态度在核准后第一时间做出修正。
    </p>
  </article>
</BaseLayout>
