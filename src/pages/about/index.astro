---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { breadcrumbJsonLd, pageJsonLd } from '../../lib/seo';
import { STATIC_PAGES, SITE } from '../../data/site';

const meta = STATIC_PAGES['/about/'];
const jsonLd = [
  breadcrumbJsonLd([{ name: '首页', url: '/' }, { name: '关于本站', url: '/about/' }]),
  pageJsonLd('AboutPage', {
    name: meta.title,
    description: meta.description,
    url: '/about/',
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    alternateName: SITE.nameZh,
    url: SITE.url,
    email: SITE.email,
    description: SITE.tagline,
    member: [
      {
        '@type': 'Person',
        name: '林蔚 (Lin Wei)',
        jobTitle: '资深网络协议与安全分析师',
        description: '专注计算机网络协议栈、TLS 混淆机制与边缘节点抓包取证，负责本站协议与底层技术词条。',
      },
      {
        '@type': 'Person',
        name: '陈博 (Chen Bo)',
        jobTitle: '网络工具与系统配置架构师',
        description: '专注多平台开源代理客户端分诊排查树构建与跨境网络故障诊断。',
      },
      {
        '@type': 'Person',
        name: '周一凡 (Zhou Yifan)',
        jobTitle: '商业透明度与风险监测员',
        description: '负责机场公开套餐审计、核验日期更新、免责披露核实与跑路前兆风险信号跟踪。',
      },
    ],
  },
  pageJsonLd('ContactPage', {
    name: '联系 HaiwaiWiki 编辑部',
    description: '内容勘误、信息过期提醒与风险线索的联系方式。',
    url: '/about/',
  }),
];
---

<BaseLayout title={meta.title} description={meta.description} path="/about/" jsonLd={jsonLd}>
  <Breadcrumb crumbs={[{ name: '关于本站', url: '/about/' }]} />
  <article class="entry-body mx-auto mt-10">
    <h1 class="text-2xl font-bold">关于 HaiwaiWiki</h1>
    <p>
      HaiwaiWiki（海外Wiki）是一个专注于网络工具、代理协议机制与跨境网络服务的中文结构化知识库。
      我们的核心目标是解决行业内长期存在的信息不对称：怎么科学选型、怎么排查网络故障、底层协议如何工作，以及哪些商业与合规风险需要提前防范。
    </p>
    <p>
      我们把所有内容组织成模块化“词条”：每个词条聚焦解决一个具体的决策点或排查步骤，严格标明初版发布与最新修订核验时间，并按统一的工程规范持续维护。
    </p>

    <h2>编辑部核心专栏成员 (Editorial Team)</h2>
    <p>
      本站所有内容均由海外Wiki编辑部集体审校。为确保专业性与透明度，以下为各技术板块的专栏负责人与学术/工程背景：
    </p>

    <div class="not-prose my-6 grid gap-4 sm:grid-cols-3">
      <div class="border border-rule bg-paper-2 p-4 rounded-xs">
        <h3 class="font-bold text-ink text-sm">林蔚 (Lin Wei)</h3>
        <p class="text-xs text-seal font-medium mt-0.5">网络协议与底层安全分析师</p>
        <p class="mt-2 text-xs text-ink-2 leading-relaxed">
          前骨干网运维工程师，拥有 8 年计算机网络协议分析经验。负责 IPLC/IEPL 专线机制、TLS 握手混淆特征（REALITY、JA3/JA4）及 QUIC 拥塞控制等深度词条的撰写与测试。
        </p>
      </div>
      <div class="border border-rule bg-paper-2 p-4 rounded-xs">
        <h3 class="font-bold text-ink text-sm">陈博 (Chen Bo)</h3>
        <p class="text-xs text-seal font-medium mt-0.5">网络工具与客户端架构分析师</p>
        <p class="mt-2 text-xs text-ink-2 leading-relaxed">
          专注于多平台开源客户端配置、TUN 模式虚拟网卡路由接管、DNS 泄漏排查与跨境应用（ChatGPT、Netflix、Claude）访问分诊框架的设计。
        </p>
      </div>
      <div class="border border-rule bg-paper-2 p-4 rounded-xs">
        <h3 class="font-bold text-ink text-sm">周一凡 (Zhou Yifan)</h3>
        <p class="text-xs text-seal font-medium mt-0.5">商业透明度与风险监测员</p>
        <p class="mt-2 text-xs text-ink-2 leading-relaxed">
          负责全站 28 家服务商公开套餐与服务条款的核验普查，监督全站联盟返利链接合规标记，并对跑路信号、异常现金流促销建立长期观察清单。
        </p>
      </div>
    </div>

    <h2>我们坚决不做什么</h2>
    <p>为了保持纯粹的工具属性与可信赖度，本站设立了不可逾越的四项原则：</p>
    <ul>
      <li><strong>不做主观评分榜单</strong>：脱离个人宽带环境、晚高峰时间段与预算的“第一名推荐”是伪命题；</li>
      <li><strong>不编造未实测的数据</strong>：没有完整测试环境、测试工具、时间戳与局限性说明的测速图和解锁百分比一律不予采纳；</li>
      <li><strong>不分发免费节点或订阅链接</strong>：杜绝安全隐患，不收集、不转储、不传播不受监管的公共代理资产；</li>
      <li><strong>不把商业宣称当作客观事实</strong>：商家的宣传文案一律明确标注为“官方宣称 / 未经验证”，并辅以已知限制提醒。</li>
    </ul>

    <h2>内容生产与四步核验工作流</h2>
    <p>
      每一篇进入正式发布的词条，必须经过严格的内部四步流水线，详见<a href="/about/editorial/">编辑规范与方法论</a>：
    </p>
    <ol>
      <li><strong>意图独立性审查</strong>：新条目必须具有明确的搜索意图或未被满足的排查场景，严禁模板式低质改写；</li>
      <li><strong>多源交叉验证</strong>：对比 RFC 标准、开源客户端官方文档与服务商控制台公开信息，拒绝单一信源引用；</li>
      <li><strong>可追溯性标注</strong>：公开参数标明核验日期，缺失项显式声明“暂未核验”，绝不凭空推测；</li>
      <li><strong>季度循环巡检</strong>：每 90 天对收录服务商的套餐变更、线路调整与客户端支持情况进行一次全站回归核验。</li>
    </ol>

    <h2>商业合作与利益冲突披露</h2>
    <p>
      我们对商业化保持完全透明。本站部分指向服务商官网的链接为商业推广链接（Affiliate Links）。
      这些链接完全遵循行业最高透明度准则：全部声明 <code>rel="nofollow sponsored noopener"</code>，且服务商给予的推广返利绝不增加读者的购买价格，亦绝不影响编辑部对已知限制与风险的客观陈述。具体细则见<a href="/about/disclaimer/">免责声明与商业披露</a>。
    </p>

    <h2>联系编辑部与勘误渠道</h2>
    <p>
      如果您在阅读过程中发现参数失效、链接异常，或者掌握了某家服务商变更条款、停止运营或异常促销的可靠线索，欢迎向编辑部反馈：
    </p>
    <p>
      官方联络邮箱：<a href={`mailto:${SITE.email}`}>{SITE.email}</a>。提交线索时请尽可能附带可查证的截图、时间与原始声明，编辑部将在 24 小时内核实并更新词条。
    </p>
  </article>
</BaseLayout>
