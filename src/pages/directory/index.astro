---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { breadcrumbJsonLd } from '../../lib/seo';
import { STATIC_PAGES } from '../../data/site';
import brandsData from '../../data/brands.json';
import PriceGbChart from '../../components/PriceGbChart.astro';
import ClaimsMatrix from '../../components/ClaimsMatrix.astro';
import BrandFactsTable from '../../components/BrandFactsTable.astro';
import BrandFilters from '../../components/BrandFilters.astro';
import FeaturedBrands from '../../components/FeaturedBrands.astro';

const meta = STATIC_PAGES['/directory/'];
const { lastVerified } = brandsData;

const jsonLd = [
  breadcrumbJsonLd([{ name: '首页', url: '/' }, { name: '机场导航', url: '/directory/' }]),
];
---

<BaseLayout title={meta.title} description={meta.description} path="/directory/" jsonLd={jsonLd}>
  <Breadcrumb crumbs={[{ name: '机场导航', url: '/directory/' }]} />

  <div class="mt-10 max-w-[820px]">
    <p class="index-num text-3xl">02</p>
    <h1 class="mt-2 text-2xl font-bold">机场档案:{brandsData.totalCount || 28} 家服务商公开信息对照</h1>
    <p class="mt-4 text-[0.95rem] text-ink-2 leading-relaxed">
      本页收录各品牌<strong class="text-ink">官网或公开页面能核验的信息</strong>:起步价格、套餐流量、
      付款周期、官方宣称的线路类型与客户端支持。支持点击各品牌名称进入<strong class="text-ink">独立评测与详情页</strong>查看专属优惠码、详细套餐与配置指引。<strong class="text-ink">不提供速度、稳定性或解锁能力的虚假排名</strong>——
      挑选思路请配合<a href="/airport/how-to-choose/">机场怎么选</a>使用。
    </p>
    <p class="mt-3 text-xs text-ink-2">
      信息核验日期:{lastVerified}。本页外链为推广链接(详见<a href="/about/disclaimer/" class="underline underline-offset-2">披露页</a>),
      经推广链接注册本站可能获得佣金,佣金不影响本页的信息呈现方式;内容整理方法见<a href="/about/editorial/" class="underline underline-offset-2">编辑规范</a>。
    </p>
  </div>

  <div class="mt-6 max-w-[1040px]">
    <FeaturedBrands />
  </div>

  <section class="mt-12">
    <h2 class="text-xs tracking-widest text-ink-2 font-semibold">全部品牌:可核验信息对照表</h2>
    <BrandFactsTable />
  </section>

  <div class="max-w-[1040px]">
    <BrandFilters />
  </div>

  <section class="mt-12 max-w-[1040px]">
    <h2 class="text-xs tracking-widest text-ink-2 font-semibold">价格与宣称对照图</h2>
    <p class="mt-1 text-xs text-ink-2">
      下面两张图的数据分别来自官方标价的算术折算与官方宣称的逐字记录。
      本站没有实测全部 28 家的速度、延迟或解锁能力,因此不提供虚假测速图、解锁评分或质量排名——
      理由写在<a href="/about/editorial/" class="underline underline-offset-2">编辑规范</a>里。各品牌实测节点图请进单品牌详情页查阅。
    </p>
    <PriceGbChart />
    <ClaimsMatrix />
  </section>

  <section class="mt-12 max-w-[820px]">
    <h2 class="text-xs tracking-widest text-ink-2 font-semibold">按需求进入场景页</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2 text-sm">
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/ranking/">16 家公开信息对比与选择指南</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/cheap/">便宜机场:每 GB 单价怎么算</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/stable/">稳定机场:怎么定义与验证</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/dedicated-line/">专线机场:值不值与辨真伪</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/chatgpt/">ChatGPT 机场:看出口 IP</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/streaming/">流媒体解锁机场</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/clash/">Clash 用户怎么挑</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/shadowrocket/">iPhone / 小火箭用户怎么挑</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/pay-as-you-go/">按量计费与不限时套餐</a></li>
      <li><span class="text-seal mr-1.5">→</span><a href="/airport/coupon/">16 家优惠码汇总</a></li>
    </ul>
  </section>
</BaseLayout>
