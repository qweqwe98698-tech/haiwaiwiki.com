---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { staticPathsFor, type AnyEntry } from '../../lib/entries';

export async function getStaticPaths() {
  return staticPathsFor('risk');
}

interface Props {
  entry: AnyEntry;
  prev?: AnyEntry;
  next?: AnyEntry;
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content />
</ArticleLayout>