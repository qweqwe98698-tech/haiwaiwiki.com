---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionDial from '../components/SectionDial.astro';
import { STATIC_PAGES } from '../data/site';

const meta = STATIC_PAGES['/404'];
---

<BaseLayout title={meta.title} description={meta.description} path="/404/" noindex>
  <div class="mt-16 max-w-[720px]">
    <p class="index-num text-5xl">404</p>
    <h1 class="mt-3 text-2xl font-bold">这个词条不存在</h1>
    <p class="mt-3 text-ink-2 text-[0.95rem] leading-relaxed">
      你访问的页面不存在或已被移动。可以<a href="/search/">检索站内词条</a>,或从下面的栏目索引重新进入。
    </p>
  </div>
  <div class="mt-10 max-w-[720px]">
    <SectionDial compact />
  </div>
</BaseLayout>
