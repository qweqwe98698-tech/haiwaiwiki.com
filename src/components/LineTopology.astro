---
/**
 * 线路原理示意图 — 讲「专线 vs 公网中转」的结构差别。
 * 这是通用技术原理图,不代表任何具体品牌的实际架构(本站无法验证品牌架构)。
 */
interface Props {
  title?: string;
}
const { title = '专线与公网中转:两条路径的结构差别' } = Astro.props;
---

<figure class="my-8 border border-rule">
  <figcaption class="border-b border-rule bg-paper-2 px-4 py-2.5">
    <span class="text-xs font-semibold tracking-widest text-ink">{title}</span>
    <span class="mt-0.5 block text-xs text-ink-2">
      通用原理示意图,<strong class="font-semibold">不代表任何具体品牌的实际架构</strong>——机场的真实拓扑对用户不可见,本站不冒充已验证。
    </span>
  </figcaption>
  <div class="overflow-x-auto p-4">
    <svg viewBox="0 0 640 300" class="mx-auto block h-auto w-full min-w-[520px] max-w-[640px]" role="img"
      aria-label="示意图:用户设备经国内入口后,分为公网跨境路径与专线跨境路径,最终到达海外落地节点与目标服务">
      <defs>
        <marker id="lt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
        </marker>
      </defs>
      <g style="color: var(--ink-2)" font-family="inherit">
        <!-- 用户设备 -->
        <rect x="16" y="128" width="104" height="44" rx="2" fill="none" stroke="var(--rule)" />
        <text x="68" y="146" text-anchor="middle" font-size="13" fill="var(--ink)">用户设备</text>
        <text x="68" y="163" text-anchor="middle" font-size="11" fill="var(--ink-2)">手机 / 电脑</text>

        <!-- 入口 -->
        <line x1="120" y1="150" x2="164" y2="150" stroke="currentColor" stroke-width="1.5" marker-end="url(#lt-arrow)" />
        <rect x="168" y="128" width="112" height="44" rx="2" fill="none" stroke="var(--rule)" />
        <text x="224" y="146" text-anchor="middle" font-size="13" fill="var(--ink)">国内入口</text>
        <text x="224" y="163" text-anchor="middle" font-size="11" fill="var(--ink-2)">加密流量转发</text>

        <!-- 分叉:公网 -->
        <path d="M280 140 L316 140 L316 68 L360 68" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#lt-arrow)" />
        <text x="330" y="58" font-size="11" fill="var(--ink-2)">公网跨境</text>
        <rect x="364" y="46" width="120" height="44" rx="2" fill="none" stroke="var(--rule)" stroke-dasharray="5 4" />
        <text x="424" y="64" text-anchor="middle" font-size="12" fill="var(--ink)">公网出口</text>
        <text x="424" y="80" text-anchor="middle" font-size="11" fill="var(--ink-2)">晚高峰与其他流量争抢</text>

        <!-- 分叉:专线 -->
        <path d="M280 160 L316 160 L316 232 L360 232" fill="none" stroke="var(--seal)" stroke-width="3.5" marker-end="url(#lt-arrow)" />
        <text x="330" y="252" font-size="11" fill="var(--seal)">IEPL / IPLC 专线</text>
        <rect x="364" y="210" width="120" height="44" rx="2" fill="none" stroke="var(--seal)" stroke-width="1.5" />
        <text x="424" y="228" text-anchor="middle" font-size="12" fill="var(--ink)">专用链路</text>
        <text x="424" y="244" text-anchor="middle" font-size="11" fill="var(--ink-2)">不经公网拥堵点</text>

        <!-- 汇入落地 -->
        <path d="M484 68 L512 68 L512 128" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 4" />
        <path d="M484 232 L512 232 L512 172" fill="none" stroke="var(--seal)" stroke-width="3.5" />
        <rect x="468" y="128" width="88" height="44" rx="2" fill="none" stroke="var(--rule)" />
        <text x="512" y="146" text-anchor="middle" font-size="13" fill="var(--ink)">海外落地</text>
        <text x="512" y="163" text-anchor="middle" font-size="11" fill="var(--ink-2)">出口 IP</text>

        <!-- 目标 -->
        <line x1="556" y1="150" x2="592" y2="150" stroke="currentColor" stroke-width="1.5" marker-end="url(#lt-arrow)" />
        <text x="600" y="146" font-size="12" fill="var(--ink)">目标</text>
        <text x="600" y="162" font-size="12" fill="var(--ink)">服务</text>
      </g>
    </svg>
  </div>
  <p class="border-t border-rule px-4 py-2 text-xs text-ink-2">
    两条路径的差别只在中间一段:专线走运营商专用链路,不与公网跨境流量争抢,所以晚高峰更平稳。
    出口 IP 的「原生 / 广播」属性由落地节点决定,与走哪条路径无关——两件事要分开看。
  </p>
</figure>
