---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 3 && (
  <details class="border border-rule bg-paper-2 px-5 py-3 text-sm" open>
    <summary class="cursor-pointer list-none select-none text-xs tracking-widest text-ink-2 font-semibold">本条目导读</summary>
    <ol class="mt-2 space-y-1.5">
      {items.map((h) => (
        <li class:list={[h.depth === 3 && 'pl-5']}>
          <a href={`#${h.slug}`} class="text-ink hover:text-seal">{h.text.replace(/#$/, '')}</a>
        </li>
      ))}
    </ol>
  </details>
)}
