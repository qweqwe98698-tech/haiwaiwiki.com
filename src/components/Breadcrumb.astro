---
import type { Crumb } from '../lib/seo';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="面包屑" class="pt-5 text-xs text-ink-2">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="text-ink-2 hover:text-seal">首页</a></li>
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true">›</span>
        {i === crumbs.length - 1 ? (
          <span aria-current="page" class="text-ink">{c.name}</span>
        ) : (
          <a href={c.url} class="text-ink-2 hover:text-seal">{c.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
