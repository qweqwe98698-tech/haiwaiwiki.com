---
/**
 * 合作展示位 — 顺序由 brands.json 的 featuredRank 决定,属于商务合作排序,
 * 与本站的评测结论、价格对照表完全分离(见 /about/disclaimer/)。
 * 每张卡片必须同时说明:适用人群、公开优势、已知限制、核验状态——
 * 不得只展示卖点,制造"已验证"的印象。
 */
import brandsData from '../data/brands.json';

interface Props {
  /** compact = 用于栏目页的紧凑版(仍保留四项要素,只是更简短)*/
  compact?: boolean;
  title?: string;
}
const { compact = false, title = '合作展示位' } = Astro.props;

const featured = brandsData.brands
  .filter((b) => b.featured)
  .sort((a, b) => (a.featuredRank ?? 99) - (b.featuredRank ?? 99));
const rel = 'nofollow sponsored noopener noreferrer';
---

<section class="my-8">
  <div class="flex items-baseline justify-between gap-4 flex-wrap">
    <h2 class="text-xs tracking-widest text-ink-2 font-semibold">{title}</h2>
    <p class="text-xs text-ink-2">核验日期 {brandsData.lastVerified}</p>
  </div>
  <p class="mt-1 text-xs text-ink-2 leading-relaxed">
    以下为商务合作展示,<strong class="font-semibold text-ink">展示顺序由合作关系决定,不代表测速、质量或评测排名</strong>——
    本站没有对这些品牌做过性能测试。「公开优势」一栏为品牌方官方宣称,<strong class="font-semibold text-ink">未经本站验证</strong>;
    链接为推广链接(<a href="/about/disclaimer/" class="underline underline-offset-2">披露</a>)。
    {compact ? (
      <>客观对照请看<a href="/directory/" class="underline underline-offset-2">按每 GB 单价排序的档案表</a>。</>
    ) : (
      <>客观数据请看下方按每 GB 单价排序的完整档案表。</>
    )}
  </p>

  <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px border border-rule bg-rule">
    {featured.map((b) => (
      <div class:list={['p-4 flex flex-col justify-between', b.featuredRank === 1 ? 'bg-seal-2/20 border-2 border-seal -m-px z-1 relative' : 'bg-paper']}>
        <div>
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-1.5 min-w-0">
              <span class="index-num text-xs font-bold text-seal">{String(b.featuredRank).padStart(2, '0')}</span>
              <a href={`/brands/${b.id}/`} class="font-bold text-ink hover:text-seal text-base hover:underline whitespace-nowrap">
                {b.name}
              </a>
            </div>
            {b.featuredRank === 1 && (
              <span class="text-[0.68rem] bg-seal text-white px-2 py-0.5 rounded-xs font-semibold whitespace-nowrap">
                No.1 核心主推
              </span>
            )}
          </div>
          <p class="mt-1.5 text-sm text-seal font-semibold">{b.priceFrom}</p>

          {b.audience && (
            <p class="mt-2 text-xs text-ink leading-relaxed">
              <span class="text-ink-2 font-medium">适用人群: </span>{b.audience}
            </p>
          )}
          {b.publicPros && (
            <p class="mt-1.5 text-xs text-ink-2 leading-relaxed">
              <span class="corner-label text-ink">公开优势</span>{b.publicPros.slice(0, 2).join('、')}
            </p>
          )}
          {b.knownLimits && (
            <p class="mt-1.5 text-xs text-ink-2 leading-relaxed">
              <span class="corner-label text-cinnabar">已知限制</span>{b.knownLimits.slice(0, 2).join('、')}
            </p>
          )}
          <p class="mt-1.5 text-xs text-ink-2">
            核验状态: <span class="text-ink font-medium">{b.verifyStatus ?? '官方资料 · 未实测'}</span>
          </p>

          {b.affCode && (
            <div class="mt-2 text-xs text-ink-2 flex items-center gap-1.5 flex-wrap">
              <span>优惠码</span>
              <code class="border border-rule bg-paper-2 px-1.5 py-0.5 rounded-xs text-seal font-mono font-bold">{b.affCode}</code>
              {b.affCodeNote && <span class="text-[0.7rem] text-ink-2">({b.affCodeNote})</span>}
            </div>
          )}
        </div>

        <div class="mt-4 pt-3 border-t border-rule text-xs flex items-center justify-between gap-2 whitespace-nowrap">
          <div class="flex items-center gap-3">
            <a href={b.affUrl} rel={rel} target="_blank" class="font-semibold text-seal hover:underline inline-flex items-center">官网注册 ↗</a>
            <a href={`/brands/${b.id}/`} class="text-ink hover:text-seal font-medium">评测详情 →</a>
          </div>
          <a href="/directory/" class="text-ink-2 hover:text-seal text-[0.72rem]">档案对照</a>
        </div>
      </div>
    ))}
  </div>
</section>
