---
/** 核验说明:数据来源与核验时间(SITE-DNA 编辑铁律 2/3)。 */
interface Props {
  reviewStatus: string;
  lastVerified?: string;
  extra?: string;
}
const { reviewStatus, lastVerified, extra } = Astro.props;
---

<aside class="rule-hair mt-12 pt-4 text-xs text-ink-2 leading-relaxed">
  <p>
    <span class="corner-label">核验说明</span>
    本文信息状态:<strong class="text-ink font-semibold">{reviewStatus}</strong>
    {lastVerified && <>;最近核验:{lastVerified}</>}。
    {extra ?? '涉及价格、套餐、可用性的描述可能随时变化,以对应服务的官方页面为准。'}
  </p>
</aside>
